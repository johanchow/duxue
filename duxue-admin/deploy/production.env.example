ADMIN_ENV=prod
ADMIN_PUBLIC_ORIGIN=https://admin.duxuelai.xyz
# Connection parameters from the Server production configuration; DB forced to duxue-admin-prod.
ADMIN_DATABASE_URL=postgresql://user:password@postgres:5432/duxue-admin-prod
AGENT_ADMIN_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters
VLM_API_KEY=replace-with-provider-key

# Optional Evaluation read integration; credentials remain server-side.
ADMIN_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
ADMIN_LANGFUSE_PROJECT_ID=
ADMIN_LANGFUSE_PUBLIC_KEY=
ADMIN_LANGFUSE_SECRET_KEY=
ADMIN_LANGFUSE_ENVIRONMENT=production
