{
  "id": "planning.intake",
  "version": "v3",
  "kind": "agent",
  "implementation": "llm",
  "agent_label": "planning",
  "risk_tier": "standard",
  "operation": "plan_intake",
  "input_contract": "plan-intake-input.v1",
  "output_contract": "plan-intake-result.v1",
  "input_schema": {
    "type": "object",
    "properties": {
      "user": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array"
          }
        ]
      }
    },
    "required": [
      "user"
    ],
    "additionalProperties": false
  },
  "context_builder_id": "planning.intake.context",
  "prompt": {
    "id": "planning.intake.prompt.v4",
    "template": "{{recent_utterance_block}}你是读学的轻量任务与专注挑战助手。今天 {{today}}。当前学生 {{ward}}。当前未完成任务池 {{tasks}}。当前草稿 {{draft_items}}。待澄清 {{clarification_slots}}。已确认自述 {{self_review_aspects}} 仅作参考，不是已执行事实。\n只输出 JSON：assistant_text、operations、slot_updates、clarification_required、questions、ready_to_confirm、study_action（可省略）。\n普通任务仅标题即可登记安排，不询问未报的预计时长或开始钟点，不询问未安排原因。时长和钟点仅提取用户明确给出的值，不默认30分钟或19:00。顺序通过 after_task_reference / before_task_reference 表达，不推算后项钟点。信息完整指目标明确，不要求时间齐全。已有任务名称从任务池复制，不能生成 assignment_id 或任何真实 ID；目标歧义要澄清。\noperations 每项 kind=create/update/schedule/defer/delete；references 是所指已有任务名称数组，title 是新增或新标题；planned_minutes（1-480）、start_at（ISO时间）、after_task_reference、before_task_reference、reason 只在用户明确表达时提供。update/delete 无匹配不得改成 create。未报时长的图片作业也可以 create。读不清或不是明确学习任务的图片先询问，不猜内容。仅名称不明、对象不唯一或字段明确但非法时澄清，禁止追问可选时间。\nslot_updates 仅回答已签发 slot_id；目标选完整名称而非ID。title_conflict 可选 use_existing（title完整名）/create_new/accept_duplicate/cancel；不广播修改歧义对象。自由语义由你理解，不能把钟表时间误作持续分钟。\n若用户要查询/执行任务或专注挑战，输出 study_action 并令 operations=[]，不要把执行当作新增作业。study_action.action 闭集：task_list（有哪些作业/先做什么）、task_time（可靠用时查询）、task_start、task_pause、task_resume、task_end（本次先到这里而未完成）、task_complete（用户声明写完）、sprint_prepare（想开始/预约专注挑战）、sprint_pause、sprint_resume、sprint_end（结束本轮）。任务操作用 task_reference 完整已有名称，对象不清必须问。挑战给出 topic、target_minutes（1-180）及可选 planned_start_at；不生成ID。普通“七点写数学预计二十分钟”只是安排，绝不作为挑战；明确“试一轮专注/挑战二十分钟”才提出 sprint_prepare，开始权由用户的确认按钮行使。缺挑战时长仅对主动挑战轻问，不阻塞普通作业。暂停/继续/结束本轮根据可见对话指代挑战，完成作业不能从计时到点推断。不得声称已专注或验证作业质量。没有可执行动作不要编造成功。\n\n槽位例：{slot_id, value:\"30分钟\"}。图片上写明预计时长才提取时长，可能不是学习任务的图片先澄清。示例：{\"kind\":\"create\",\"title\":\"数学口算\"}。要求“同样的操作”时只能依据可见原句，无法确定就 clarification_required=true。\n\n已授权查询的当前挑战 {{current_sprint}}。为空时不要从旧聊天认定仍有挑战；运行/暂停状态用于理解“暂停一下”等省略，只有当前挑战存在时才承接相应动作。\n\n提供 planned_minutes 时用 duration_kind 区分 completion_estimate（预计多久写完）和 timebox（本次打算投入多久）；不把 timebox 自动变成专注挑战。\n",
    "delivery": "user",
    "variables": {
      "today": {
        "type": "string",
        "binding": "context.today"
      },
      "recent_utterance_block": {
        "type": "string",
        "binding": "context.recent_utterance_block"
      },
      "ward": {
        "type": "object",
        "binding": "context.ward"
      },
      "tasks": {
        "type": "array",
        "binding": "context.tasks"
      },
      "draft_items": {
        "type": "array",
        "binding": "context.draft_items"
      },
      "clarification_slots": {
        "type": "array",
        "binding": "context.clarification_slots"
      },
      "self_review_aspects": {
        "type": "array",
        "binding": "context.self_review_aspects"
      },
      "current_sprint": {
        "type": "object",
        "binding": "context.current_sprint"
      }
    }
  },
  "tools": [],
  "models": [
    {
      "component_id": "planning.intake",
      "name": "qwen3.7-plus-2026-05-26",
      "temperature": 0,
      "max_output_tokens": 1600,
      "timeout_ms": 60000
    }
  ],
  "accepts_images": true,
  "requires_agent_switch": false,
  "output_schema": {
    "$defs": {
      "PlanningOperation": {
        "properties": {
          "kind": {
            "enum": [
              "create",
              "update",
              "schedule",
              "defer",
              "delete"
            ],
            "title": "Kind",
            "type": "string"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "References",
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "planned_minutes": {
            "anyOf": [
              {
                "maximum": 480,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Planned Minutes"
          },
          "start_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start At"
          },
          "after_task_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "After Task Reference"
          },
          "before_task_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Before Task Reference"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "duration_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "completion_estimate",
              "timebox",
              null
            ]
          }
        },
        "required": [
          "kind"
        ],
        "title": "PlanningOperation",
        "type": "object"
      }
    },
    "properties": {
      "assistant_text": {
        "maxLength": 4000,
        "minLength": 1,
        "title": "Assistant Text",
        "type": "string"
      },
      "clarification_required": {
        "default": false,
        "title": "Clarification Required",
        "type": "boolean"
      },
      "questions": {
        "items": {
          "type": "string"
        },
        "maxItems": 5,
        "title": "Questions",
        "type": "array"
      },
      "ready_to_confirm": {
        "default": false,
        "title": "Ready To Confirm",
        "type": "boolean"
      },
      "slot_updates": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "maxItems": 30,
        "title": "Slot Updates",
        "type": "array"
      },
      "operations": {
        "items": {
          "$ref": "#/$defs/PlanningOperation"
        },
        "maxItems": 30,
        "title": "Operations",
        "type": "array"
      },
      "study_action": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "sprint_prepare",
              "sprint_pause",
              "sprint_resume",
              "sprint_end",
              "task_list",
              "task_time",
              "task_start",
              "task_pause",
              "task_resume",
              "task_end",
              "task_complete"
            ]
          },
          "topic": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 180
          },
          "task_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "planned_start_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "assistant_text"
    ],
    "title": "PlanIntakeResult",
    "type": "object",
    "additionalProperties": false
  },
  "error_codes": [
    "agent_execution_failed",
    "invalid_model_candidate",
    "model_provider_disabled",
    "model_provider_not_configured",
    "model_transport_error"
  ]
}
