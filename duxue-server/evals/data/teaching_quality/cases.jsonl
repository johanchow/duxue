{"id":"turn-rubric-10","component":"tutoring.turn","conversation_id":"rubric","turn_index":10,"history":[],"student_said":"What does hypotenuse mean? I cannot start until I know the word.","images":[],"context":{"problem":{"summary":"直角三角形两直角边是 3 和 4，求斜边","active_subgoal":"先弄清斜边指哪一条边","substantive_attempts":0,"hints_given":0,"evidence_summary":null},"task_title":"数学作业","task_active":true,"tutoring_intent":null,"focus_agent_type":null},"expect":{"outcome_in":["answer"],"outcome_not_in":["fallback"],"lesson_source_contains_any":[],"content_contains_any":["直角","right angle","longest","对边"],"content_not_contains":["c = 5","c=5","equals 5","等于 5","is 5"],"intent_in":[]},"tags":["rubric","prerequisite"],"source":"synthetic","flags":[],"label_status":"proposed","reviewed_by":null,"note":"前置概念。作业里的词义应直接回答，同时不得把 3-4-5 的结果算出来。"}
