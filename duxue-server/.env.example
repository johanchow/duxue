# 环境变量模板 —— 本文件提交 Git，只列变量名不填真实值。
# 启动前会校验 DATABASE_URL、JWT_SECRET_KEY/SECRET_KEY、Redis、VLM API Key；
# STORAGE_BACKEND=oss 时还会校验 OSS endpoint、bucket 与访问密钥。
# 本地默认读取同目录 `.env`（`python main.py` / 导入 app 时自动 load）。
# 换文件：ENV_FILE=.env.prod python main.py
# `.env.prod` 只存在于 ECS，不要提交 Git。

# ── 数据库（应用会把旧文档中的 asyncpg URL 兼容转换为 psycopg）
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/duxue

# ── Redis / Celery
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# 阿里云 Redis 开启 TLS 时填 rediss；VPC 非 TLS 默认 redis。
REDIS_SCHEME=redis

# ── OSS（帧图片）
STORAGE_BACKEND=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=duxue-frames-prod
OSS_ENDPOINT_INTERNAL=oss-cn-hangzhou-internal.aliyuncs.com
OSS_ENDPOINT_PUBLIC=oss-cn-hangzhou.aliyuncs.com
OSS_PRESIGN_EXPIRE_SECONDS=300

# 本地开发无需 OSS 时改用这两项
LOCAL_UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=http://localhost:8000

# ── 认证
JWT_SECRET_KEY=
DEVICE_TOKEN_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── AI 推理（Batch 为主、实时为超时降级）
VLM_API_KEY=
VLM_MODEL_NAME=qwen3-vl-flash
# Guardian 对话式任务整理（文字 + 图片）；留空时默认复用 VLM_MODEL_NAME。
TASK_INTAKE_MODEL=qwen3-vl-flash
# `guardian/<guardian-id>/task-intake/` 是确认前的临时图片路径。
# 生产 OSS 请配置该前缀的生命周期规则，兜底删除未完成会话留下的文件。
# Optional independent models for the daily-story experience. They default to
# VLM_MODEL_NAME and can be changed without a code or schema migration.
TUTORING_MODEL_NAME=
INSIGHT_MODEL_NAME=
GUARDIAN_STORY_MODEL_NAME=
VLM_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_BATCH_COMPLETION_WINDOW=24h
VLM_BATCH_SUBMIT_HOUR=22
VLM_BATCH_FALLBACK_AFTER_HOURS=20
VLM_REALTIME_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 百炼实时语音转文字（Guardian 传递输入栏）
# API Key 只放服务端 .env / .env.prod，绝不能写入 Flutter App。
# 北京地域请填业务空间 ID；其他地域或自定义网关可直接填完整 WSS URL。
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash-realtime
ASR_WORKSPACE_ID=
ASR_WEBSOCKET_URL=
ASR_MAX_RECORD_SECONDS=60

# ── 采集与留存
CAPTURE_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=180
FRAME_RETENTION_DAYS=90

# ── 应用配置
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# 仅填写实际承载 Admin Web 的 HTTPS origin，多个值用英文逗号分隔。
CORS_ALLOW_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# 生产环境必须设为 false，并通过 `alembic upgrade head` 建表/迁移。
AUTO_CREATE_SCHEMA=false
