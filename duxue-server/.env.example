# 环境变量模板 —— 本文件提交 Git，只列变量名不填真实值。
# 启动前会校验 DATABASE_URL、JWT_SECRET_KEY/SECRET_KEY、Redis、VLM API Key；
# STORAGE_BACKEND=oss 时还会校验 OSS endpoint、bucket 与访问密钥。
# 本地默认读取同目录 `.env`（`python main.py` / 导入 app 时自动 load）。
# 换文件：ENV_FILE=.env.prod python main.py
# `.env.prod` 只存在于 ECS，不要提交 Git。

# ── 数据库（应用会把旧文档中的 asyncpg URL 兼容转换为 psycopg）
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/duxue

# ── Redis / Celery
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# 阿里云 Redis 开启 TLS 时填 rediss；VPC 非 TLS 默认 redis。
REDIS_SCHEME=redis

# ── OSS（帧图片）
STORAGE_BACKEND=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=duxue-frames-prod
OSS_ENDPOINT_INTERNAL=oss-cn-hangzhou-internal.aliyuncs.com
OSS_ENDPOINT_PUBLIC=oss-cn-hangzhou.aliyuncs.com
OSS_PRESIGN_EXPIRE_SECONDS=300

# 本地开发无需 OSS 时改用这两项
LOCAL_UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=http://localhost:8000

# ── 认证
JWT_SECRET_KEY=
DEVICE_TOKEN_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── Guardian 邮箱验证码（生产 .env.prod 也需配置）
# MAIL_SECURE=true 使用 SSL（通常 465）；false 使用 STARTTLS（通常 587）。
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ── AI 推理（Batch 为主、实时为超时降级）
VLM_API_KEY=
VLM_MODEL_NAME=qwen3-vl-flash-2026-01-22
# `guardian/<guardian-id>/task-intake/` 是确认前的临时图片路径。
# 生产 OSS 请配置该前缀的生命周期规则，兜底删除未完成会话留下的文件。
# 文本类 LLM 调用的模型名、prompt、参数都在 app/infrastructure/ai/components.py。
# 应急覆盖（仅 standard 组件，protected 的 tutoring.* 不可覆盖；格式错误会拒绝启动）：
# AI_MODEL_OVERRIDES={"planning.intake": "qwen3.7-plus-2026-05-26"}
AI_MODEL_OVERRIDES=
AGENT_MODEL_TIMEOUT_SECONDS=20
# Agent 对话会发送最小化、脱敏后的 ContextEnvelope 给 Qwen；完成审查后才开启。
AGENT_MODEL_ENABLED=false
VLM_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_BATCH_COMPLETION_WINDOW=24h
VLM_BATCH_SUBMIT_HOUR=22
VLM_BATCH_FALLBACK_AFTER_HOURS=20
VLM_REALTIME_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 百炼实时语音转文字（Guardian 传递输入栏）
# API Key 只放服务端 .env / .env.prod，绝不能写入 Flutter App。
# 北京地域请填业务空间 ID；其他地域或自定义网关可直接填完整 WSS URL。
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash-realtime
ASR_WORKSPACE_ID=
ASR_WEBSOCKET_URL=
ASR_MAX_RECORD_SECONDS=60

# ── 智能语音交互 · 标准语音合成（发音点读）
# Appkey 与上面的 OSS AccessKey 必须属于同一个阿里云账号，服务端用这对密钥换 Token。
# 音色不在这里配置：en-US=betty，en-GB=emily，写在发音适配器的登记表里。
TTS_APPKEY=
TTS_GATEWAY_URL=https://nls-gateway-cn-shenzhen.aliyuncs.com/stream/v1/tts
TTS_TOKEN_URL=https://nls-meta.cn-shanghai.aliyuncs.com/

# ── 采集与留存
CAPTURE_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=180
FRAME_RETENTION_DAYS=90

# ── 应用配置
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# 仅填写实际承载 Admin Web 的 HTTPS origin，多个值用英文逗号分隔。
CORS_ALLOW_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# 生产环境必须设为 false，并通过 `alembic upgrade head` 建表/迁移。
AUTO_CREATE_SCHEMA=false

# ── OpenTelemetry（标准 OTLP HTTP，直接上报 Grafana）
# 留空时应用不初始化 exporter，适合未接入可观测性的本地开发。
OTEL_SERVICE_NAME=duxue-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# 测试或离线调试可强制关闭全部导出。
OTEL_SDK_DISABLED=false
# 可选 Langfuse：默认关闭，本地调试无需配置也无需额外进程。开启时仅导出
# 经审查的 Agent 执行链路与 LLM span；session_id=thread_id，run_id 为执行关联字段。
# 不记录 prompt、completion、工具正文、图片、SVG 或 ContextEnvelope。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# 仅用于一个受控、加密并具备短留存策略的本地挂载目录；绝不填写普通应用日志路径。
AGENT_DEBUG_AUDIT_ENABLED=false
AGENT_DEBUG_AUDIT_PATH=
