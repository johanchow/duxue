# 环境变量模板 —— 本文件提交 Git，只列变量名不填真实值。
#
#   .env.dev   本地开发用，加入 .gitignore
#   .env.prod  只存在于 ECS，永远不入 Git
#
# 完整说明见 docs/preparetion.md 第六节。

# ── 数据库（阿里云 RDS 连接串）
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/duxue

# ── Redis（阿里云云数据库 Redis）
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ── OSS（帧图片）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=duxue-frames-prod
# Worker 打包批次时读帧走内网，免流量费
OSS_ENDPOINT_INTERNAL=oss-cn-hangzhou-internal.aliyuncs.com
# 预签名 URL 是给手机用的，必须走公网
OSS_ENDPOINT_PUBLIC=oss-cn-hangzhou.aliyuncs.com
OSS_PRESIGN_EXPIRE_SECONDS=300

# ── 认证
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# 设备 Token 签名密钥，与 JWT 密钥分开
DEVICE_TOKEN_SECRET=

# ── AI 推理（阿里云百炼，Batch 为主、实时为降级）
VLM_API_KEY=
VLM_MODEL_NAME=qwen3-vl-flash
VLM_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_BATCH_COMPLETION_WINDOW=24h
VLM_BATCH_SUBMIT_HOUR=22
VLM_BATCH_FALLBACK_AFTER_HOURS=20
VLM_REALTIME_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 采集
CAPTURE_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=180

# ── 数据留存
# 第一期 90 天以积累 fine-tune 训练数据；
# 对外提供服务前收紧至 30，并同步改 OSS 生命周期规则
FRAME_RETENTION_DAYS=90

# ── 应用配置
APP_ENV=development
APP_BASE_URL=http://localhost:8000
