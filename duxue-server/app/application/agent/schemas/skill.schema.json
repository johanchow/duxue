{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duxue.internal/schemas/skill.schema.json",
  "title": "Duxue Declarative Skill Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "display_name",
    "description",
    "allowed_roles",
    "tools",
    "required_gates",
    "instructions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "kind": {
      "const": "skill"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "allowed_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["teacher", "coach", "guardian", "ward"]
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      }
    },
    "required_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_artifact_type": {
      "type": ["string", "null"],
      "enum": [
        "interactive_courseware",
        "grading_report",
        "lesson_pack",
        "creative_work",
        null
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  }
}
